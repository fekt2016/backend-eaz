# ─── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# ─── MongoDB ─────────────────────────────────────────────
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/eazworld
DATABASE_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7d

# ─── Frontend URLs ────────────────────────────────────────
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── Resend (all emails) ─────────────────────────────────
# Get API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender address — must match a verified domain in Resend
EMAIL_FROM=EazWorld <noreply@eazworld.com>
# Admin email — receives contact form notifications
ADMIN_EMAIL=hello@eazworld.com

# ─── Paystack ────────────────────────────────────────────
# Get keys: https://dashboard.paystack.com → Settings → API Keys
# Use sk_test_... for testing, sk_live_... for production
PAYSTACK_KEY=pk_test_xxxx
PAYSTACK_SECRET=sk_test_xxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxx

# ─── Cloudinary (proof of payment uploads) ───────────────
# Get keys: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Namecheap (domain search + registration) ────────────
# Apply for API access: https://www.namecheap.com/support/api/intro/
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
# Set to false in production
NAMECHEAP_SANDBOX=true
# GHS conversion: price = USD_price × USD_TO_GHS_RATE × DOMAIN_MARKUP
USD_TO_GHS_RATE=15.5
DOMAIN_MARKUP=1.2

# ─── WHM / cPanel hosting provisioning ───────────────────
# Asura Hosting has NO standalone provisioning API. To provision on Asura, buy a
# cPanel RESELLER plan, generate a WHM API token (WHM → "API Tokens"), and point
# these at your Asura WHM server. These same vars drive any cPanel/WHM host.
WHM_HOST=https://your-asura-whm-host:2087   # your reseller WHM URL
WHM_USER=your_reseller_username             # NOT 'root' on a reseller account
WHM_TOKEN=your-whm-api-token

# WHM packages are prefixed with the reseller username. Package names are derived
# as `<prefix>_eazworld_<planType>_<tier>`. Defaults to WHM_USER; override if your
# WHM packages use a different owner/prefix.
# WHM_PACKAGE_PREFIX=your_reseller_username

# Nameservers customers must point their domain at (comma-separated, from Asura/WHM).
HOSTING_NAMESERVERS=ns1.eazworld.com,ns2.eazworld.com

# Expiry lifecycle (days): grace after expiry → suspend, then → terminate.
HOSTING_GRACE_DAYS=7
HOSTING_SUSPEND_TO_TERMINATE_DAYS=30

# Optional: canonical cPanel URL included in hosting credential emails (default: https://{domain}:2083)
# CPANEL_URL=https://your-server-hostname:2083
