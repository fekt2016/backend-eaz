# ─────────────────────────────────────────────────────────────────────────────
# EazWorld backend — environment reference (T132)
#
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
# This file lists EVERY variable the backend code reads, so "not in here" means
# "not used". Tiers:
#
#   REQUIRED     utils/validateEnv.js calls process.exit(1) if absent
#   RECOMMENDED  validateEnv warns; the related feature silently no-ops without it
#   OPTIONAL     has a code-side default, shown as [default: …]
#
# Money is stored in pesewas (GH₵1.00 = 100). Nothing here is a money value.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ REQUIRED ═══════════════════════════════════════════════════════════════

# MongoDB connection string. `mongo_url` and `MONGO_URI` are accepted as
# fallbacks, in that order, for older deployments — prefer MONGO_URL.
MONGO_URL=mongodb+srv://user:<PASSWORD>@cluster.mongodb.net/eazworld

# Only required when MONGO_URL literally contains the token `<PASSWORD>`;
# validateEnv substitutes it. `database_password` is accepted as a fallback.
DATABASE_PASSWORD=

# Signs the auth JWT carried in the httpOnly cookie. Minimum 32 characters —
# validateEnv refuses to boot below that. Generate: openssl rand -hex 64
JWT_SECRET=generate-with-openssl-rand-hex-64

# Paystack secret key — verifies webhook signatures and initialises payments.
# REQUIRED in production (validateEnv exits); in development it only warns, and
# webhooks are rejected until set. `PAYSTACK_KEY` is an accepted fallback name.
PAYSTACK_SECRET=<your-paystack-secret-key>

# ═══ RECOMMENDED (validateEnv warns; feature is off without it) ═════════════

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Verified Resend sender for every transactional email (T62).
# Falls back to EMAIL_FROM, then to a hardcoded default.
RESEND_FROM_EMAIL=EazWorld <noreply@eazworld.com>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Spaceship domain registration. NOTE: Spaceship has no sandbox — every
# registration spends real money. tests/setup.js blanks these on purpose;
# do not remove that.
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=

# Powers the AI chat assistant (controllers/chatController.js). Without it the
# controller degrades to its non-AI path rather than erroring.
ANTHROPIC_API_KEY=

# ═══ OPTIONAL — server ══════════════════════════════════════════════════════

NODE_ENV=development                  # [default: unset] production enables the Secure/
                                      # sameSite=strict auth cookie AND suppresses err.stack
                                      # in responses. Set it in cPanel → Setup Node.js App
                                      # ("Application mode: Production") — nothing else sets it.
PORT=5000                             # [default: 5000]
HOST=0.0.0.0                          # [default: 0.0.0.0]
NODE_OPTIONS=--max-old-space-size=512 # [default: unset] Spaceship Essential is a shared
                                      # 1-core plan; keep the heap at 512MB.
                                      # server.js logs the value when present.
LOG_LEVEL=info                        # [default: info] error|warn|info|debug (utils/logger.js)
COOKIE_SECRET=                        # [default: unset] signs cookies via cookie-parser

# ═══ OPTIONAL — URLs and identity ═══════════════════════════════════════════

# Public site URL. Interpolated into Paystack callback_url and customer
# tracking links. CLIENT_URL is an accepted fallback.
# ⚠️ Currently degrades to "" instead of failing fast — see T119.
FRONTEND_URL=http://localhost:3000
CLIENT_URL=

ADMIN_EMAIL=hello@eazworld.com        # [default: hello@eazworld.com] admin notification inbox
EMAIL_FROM=                           # [default: unset] legacy fallback for RESEND_FROM_EMAIL
SHOP_NAME=EazWorld                    # shown on receipts/emails
SHOP_PHONE=                           # shown on receipts/emails

JWT_EXPIRES_IN=90d                    # token lifetime
JWT_COOKIE_EXPIRES_IN=90              # cookie lifetime in DAYS

# ═══ OPTIONAL — SMS (Hubtel) ════════════════════════════════════════════════
# services/notify.js + reminderJob.js. Without these, SMS silently no-ops —
# which includes the phone-change OTP added in T84.

HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=

# ═══ OPTIONAL — hosting provisioning (WHM) ══════════════════════════════════
# services/whm.js. If WHM is not configured, provisioning routes to the manual
# queue rather than failing.

WHM_HOST=https://your-vps-host:2087
WHM_USER=root
WHM_TOKEN=
WHM_PACKAGE_PREFIX=                   # [default: WHM_USER, else "root"] cPanel package prefix
CPANEL_URL=                           # [default: https://<domain>:2083] cPanel link in
                                      # hosting emails (utils/hostingEmail.js). Distinct from
                                      # the dashboard SSO button, which uses a one-time URL
                                      # returned by WHM itself.
HOSTING_NAMESERVERS=                  # [default: unset] comma-separated, for provisioning
HOSTING_GRACE_DAYS=                   # [default in code] days past expiry before suspension
HOSTING_SUSPEND_TO_TERMINATE_DAYS=    # [default in code] days suspended before termination

NAMESERVER_1=ns1.eazworld.co
NAMESERVER_2=ns2.eazworld.co

# ═══ OPTIONAL — domain pricing ══════════════════════════════════════════════
# Spaceship exposes no pricing endpoint, so per-TLD USD costs live in
# config/domainPricing.js and are converted with these. Update when rates move.

# USD_TO_GHS_RATE and DOMAIN_MARKUP were REMOVED on 2026-08-31. The exchange rate
# and the domain profit margin are now edited by an admin at
# /dashboard/domain-orders and stored in Settings.pricing, so changing a price no
# longer needs a redeploy. Setting them here does nothing.

# ═══ OPTIONAL — delivery distance pricing ═══════════════════════════════════
# Blocked on Google Cloud billing + Routes API — see the project notes.

GOOGLE_MAPS_API_KEY=
WAREHOUSE_ADDRESS=
WAREHOUSE_LAT=
WAREHOUSE_LNG=

# ═══ OPTIONAL — background jobs ═════════════════════════════════════════════
# ⚠️ These jobs run in-process. If the API is ever scaled past one instance
#    they double-run — see T96.

REMINDER_AFTER_DAYS=                  # [default in code] days before the first reminder
REMINDER_INTERVAL_DAYS=               # [default in code] gap between reminders
REMINDER_MAX=                         # [default in code] max reminders per job
REFUND_RECONCILE_AFTER_MINUTES=60     # [default: 60] delay before reconciling a refund

# ═══ TEST / TOOLING ONLY ════════════════════════════════════════════════════

MONGOMS_VERSION=7.0.14                # [default: 7.0.14] mongodb-memory-server binary
SEED_ROLE_ACCOUNTS_FORCE=             # set to 1 to let `npm run seed:role-accounts`
                                      # run with NODE_ENV=production (it refuses otherwise)

# ─── Legacy lowercase fallbacks, read but not to be set in new deployments ───
# mongo_url          → use MONGO_URL
# database_password  → use DATABASE_PASSWORD
